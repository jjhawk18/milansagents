# --- Core ---
# Set to "true" to run the entire pipeline offline with mock LLM responses and a
# local JSON store (no keys needed). Great for testing the flow.
DRY_RUN=false

# --- LLM backend (fact verification, angle generation, content, QC) ---
# Option A (default): Claude Code CLI on your Claude Pro/Max subscription.
#   No key needed — install Claude Code and run `claude login` once on this
#   machine. Uses your plan's included usage instead of per-token API billing.
USE_CLAUDE_CODE=true

# Option B: Anthropic API (per-token billing). Set the key and
# USE_CLAUDE_CODE=false to use this instead.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase (stories, sources, brand knowledge, approvals, content) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Discovery sources ---
TAVILY_API_KEY=tvly-...
# Comma-separated RSS feeds to poll
RSS_FEEDS=https://www.quirks.com/rss,https://www.greenbook.org/mr/feed,https://techcrunch.com/category/artificial-intelligence/feed/

# --- Publishing ---
WORDPRESS_URL=https://focusinsite.com
WORDPRESS_USER=api-user
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Social posting goes through Go High Level / Zapier webhooks (already in the stack)
GHL_WEBHOOK_URL=
ZAPIER_SOCIAL_WEBHOOK_URL=

# --- Dashboard ---
DASHBOARD_PORT=3000
