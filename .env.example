# ============================================================
# Minimal real-mode setup: NOTHING below is required.
# With this file copied as-is (cp .env.example .env), the pipeline runs
# real news from RSS + real Claude via your Claude Code login, and stores
# everything in a local file (.local-store/db.json). Add credentials only
# when you want the extra capability.
# ============================================================

# Set to "true" to run fully offline with mock LLM responses (npm run demo
# does this automatically).
DRY_RUN=false

# --- LLM backend ---
# Default: Claude Code CLI on your Claude Pro/Max subscription.
# Requires Claude Code installed + logged in on this machine. No key needed.
USE_CLAUDE_CODE=true
# Alternative: Anthropic API (per-token billing). Uncomment both lines:
# USE_CLAUDE_CODE=false
# ANTHROPIC_API_KEY=

# --- Discovery: RSS feeds (comma-separated) ---
# TechCrunch AI is verified working. Add your own industry feeds —
# candidates to try (verify they load in your browser first):
#   https://venturebeat.com/category/ai/feed/
#   https://www.marktechpost.com/feed/
#   https://feeds.arstechnica.com/arstechnica/technology-lab
RSS_FEEDS=https://techcrunch.com/category/artificial-intelligence/feed/

# --- Discovery: Tavily news search (optional, free tier at tavily.com) ---
# Leave blank to run on RSS only.
TAVILY_API_KEY=

# --- Supabase (optional) ---
# Leave blank to use the local JSON store. To use Supabase: create a project,
# run supabase/migrations/001_initial_schema.sql in its SQL editor, then fill
# these in.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Publishing (optional — without these, publish logs a dry-run) ---
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
GHL_WEBHOOK_URL=
ZAPIER_SOCIAL_WEBHOOK_URL=

# --- HawkEye (competitor & market intelligence agent) ---
# All optional — sensible defaults apply. Set HAWKEYE_ENABLED=false to turn
# the agent off entirely (scans exit immediately, dashboard stays visible).
HAWKEYE_ENABLED=true
# Cost controls
# HAWKEYE_MAX_COMPANIES_PER_RUN=15
# HAWKEYE_MAX_URLS_PER_COMPANY=4
# HAWKEYE_MAX_AI_CALLS_PER_RUN=20
# HAWKEYE_MAX_SEARCHES_PER_COMPANY=1
# HAWKEYE_CONTENT_MAX_CHARS=30000
# HAWKEYE_MIN_SIGNAL_SCORE=25
# Schedule lives in systemd (scripts/deploy-vps.sh): Mon/Wed/Fri 07:15 America/New_York

# --- Dashboard ---
DASHBOARD_PORT=3000
# REQUIRED for internet-facing servers: any username + this password at the
# browser prompt. Leave blank for localhost-only use.
DASHBOARD_PASSWORD=

# --- Headless servers only (VPS) ---
# Generate on a machine where you're logged in: `claude setup-token`
# Lets the server run Claude Code on your Max/Pro subscription.
CLAUDE_CODE_OAUTH_TOKEN=
